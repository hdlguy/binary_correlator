<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="correlator_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="correlator_tb" />
            <top_module name="glbl" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000000 us"></ZoomStartTime>
      <ZoomEndTime time="40.000001 us"></ZoomEndTime>
      <Cursor1Time time="0.000000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="199"></NameColumnWidth>
      <ValueColumnWidth column_width="100"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="9" />
   <wvobject type="logic" fp_name="/correlator_tb/clk">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/correlator_tb/rst">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/correlator_tb/s_tvalid">
      <obj_property name="ElementShortName">s_tvalid</obj_property>
      <obj_property name="ObjectShortName">s_tvalid</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/correlator_tb/s_tdata">
      <obj_property name="ElementShortName">s_tdata</obj_property>
      <obj_property name="ObjectShortName">s_tdata</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/correlator_tb/s_tlast">
      <obj_property name="ElementShortName">s_tlast</obj_property>
      <obj_property name="ObjectShortName">s_tlast</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/correlator_tb/s_tready">
      <obj_property name="ElementShortName">s_tready</obj_property>
      <obj_property name="ObjectShortName">s_tready</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/correlator_tb/m_tvalid">
      <obj_property name="ElementShortName">m_tvalid</obj_property>
      <obj_property name="ObjectShortName">m_tvalid</obj_property>
      <obj_property name="CustomSignalColor">#FAAFBE</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/correlator_tb/m_tlast">
      <obj_property name="ElementShortName">m_tlast</obj_property>
      <obj_property name="ObjectShortName">m_tlast</obj_property>
      <obj_property name="CustomSignalColor">#FAAFBE</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/correlator_tb/m_tdata">
      <obj_property name="ElementShortName">m_tdata[15:0]</obj_property>
      <obj_property name="ObjectShortName">m_tdata[15:0]</obj_property>
      <obj_property name="CustomSignalColor">#FAAFBE</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
      <obj_property name="Radix">SIGNEDDECRADIX</obj_property>
      <obj_property name="CellHeight">100</obj_property>
      <obj_property name="AnalogYRangeType">ANALOG_YRANGETYPE_AUTO</obj_property>
      <obj_property name="AnalogYRangeMin">0.000000</obj_property>
      <obj_property name="AnalogYRRangeMax">0.000000</obj_property>
      <obj_property name="AnalogInterpolation">ANALOG_INTERPOLATION_HOLD</obj_property>
      <obj_property name="AnalogOffscale">ANALOG_OFFSCALE_HIDE</obj_property>
      <obj_property name="AnalogHorizLine">0.000000</obj_property>
      <obj_property name="WaveformStyle">STYLE_ANALOG</obj_property>
   </wvobject>
</wave_config>
